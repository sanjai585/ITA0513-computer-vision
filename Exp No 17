# Edge Detection using Sobel X
# Google Colab
# ==========================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# Upload image
uploaded = files.upload()

# Read uploaded image
image_name = list(uploaded.keys())[0]
img = cv2.imread(image_name)

# Convert BGR to RGB
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Convert to Grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Apply Gaussian Blur (optional)
gray = cv2.GaussianBlur(gray, (3, 3), 0)

# Apply Sobel Operator along X-axis
sobel_x = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)

# Convert to uint8
sobel_x = cv2.convertScaleAbs(sobel_x)

# Display images
plt.figure(figsize=(12,6))

plt.subplot(1,2,1)
plt.imshow(img_rgb)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,2,2)
plt.imshow(sobel_x, cmap='gray')
plt.title("Sobel Edge Detection (X-axis)")
plt.axis("off")

plt.show()

# Save output image
cv2.imwrite("Sobel_X_Output.jpg", sobel_x)

print("Output saved as: Sobel_X_Output.jpg")

# Download output image
files.download("Sobel_X_Output.jpg")
