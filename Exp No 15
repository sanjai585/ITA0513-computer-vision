# ==========================================
# Direct Linear Transformation (DLT)
# Google Colab
# ==========================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# Upload image
uploaded = files.upload()

# Read uploaded image
image_name = list(uploaded.keys())[0]
img = cv2.imread(image_name)

# Convert BGR to RGB
img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Image size
h, w = img.shape[:2]

# -----------------------------
# Source and Destination Points
# -----------------------------
src_pts = np.array([
    [50, 50],
    [w-50, 50],
    [w-50, h-50],
    [50, h-50]
], dtype=np.float32)

dst_pts = np.array([
    [0, 0],
    [w-100, 50],
    [w-50, h-100],
    [100, h]
], dtype=np.float32)

# -----------------------------
# Direct Linear Transformation
# -----------------------------
A = []

for i in range(4):
    x, y = src_pts[i]
    u, v = dst_pts[i]

    A.append([-x, -y, -1, 0, 0, 0, u*x, u*y, u])
    A.append([0, 0, 0, -x, -y, -1, v*x, v*y, v])

A = np.array(A)

# Solve using Singular Value Decomposition (SVD)
U, S, Vt = np.linalg.svd(A)

H = Vt[-1].reshape(3,3)

# Normalize Homography Matrix
H = H / H[2,2]

print("Homography Matrix (Computed using DLT):")
print(H)

# -----------------------------
# Apply Transformation
# -----------------------------
warped = cv2.warpPerspective(img, H, (w, h))

# -----------------------------
# Display Results
# -----------------------------
plt.figure(figsize=(14,6))

plt.subplot(1,2,1)
plt.imshow(img)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,2,2)
plt.imshow(warped)
plt.title("DLT Transformed Image")
plt.axis("off")

plt.show()

# -----------------------------
# Save Output
# -----------------------------
output = cv2.cvtColor(warped, cv2.COLOR_RGB2BGR)
cv2.imwrite("DLT_Transformed_Image.jpg", output)

print("\nOutput saved as: DLT_Transformed_Image.jpg")

# Download output image
files.download("DLT_Transformed_Image.jpg")
