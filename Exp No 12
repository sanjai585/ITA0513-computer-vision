# Perspective Transformation on an Image
# Google Colab
# ==========================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# Upload image
uploaded = files.upload()

# Read uploaded image
image_name = list(uploaded.keys())[0]
img = cv2.imread(image_name)

# Convert BGR to RGB
img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Get image size
height, width = img.shape[:2]

# Define four source points (corners in the original image)
pts1 = np.float32([
    [50, 50],
    [width - 50, 50],
    [50, height - 50],
    [width - 50, height - 50]
])

# Define four destination points (new perspective)
pts2 = np.float32([
    [0, 0],
    [width, 100],
    [100, height],
    [width - 100, height - 50]
])

# Compute Perspective Transformation Matrix
matrix = cv2.getPerspectiveTransform(pts1, pts2)

# Apply Perspective Transformation
transformed = cv2.warpPerspective(img, matrix, (width, height))

# Display Original and Transformed Images
plt.figure(figsize=(14,6))

plt.subplot(1,2,1)
plt.imshow(img)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,2,2)
plt.imshow(transformed)
plt.title("Perspective Transformed Image")
plt.axis("off")

plt.show()

# Print Perspective Transformation Matrix
print("Perspective Transformation Matrix:")
print(matrix)

# Save transformed image
output = cv2.cvtColor(transformed, cv2.COLOR_RGB2BGR)
cv2.imwrite("Perspective_Transformed_Image.jpg", output)

print("\nOutput saved as: Perspective_Transformed_Image.jpg")

# Download output image
files.download("Perspective_Transformed_Image.jpg")
