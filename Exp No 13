# Perspective Transformation on a Video
# Google Colab
# ==========================================

import cv2
import numpy as np
from google.colab import files

# Upload video
uploaded = files.upload()

video_name = list(uploaded.keys())[0]

# Open the uploaded video
cap = cv2.VideoCapture(video_name)

# Get video properties
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps = cap.get(cv2.CAP_PROP_FPS)

# Output video
output_name = "Perspective_Transformed_Video.mp4"

fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter(output_name, fourcc, fps, (width, height))

# Define source points
src_pts = np.float32([
    [50, 50],
    [width - 50, 50],
    [50, height - 50],
    [width - 50, height - 50]
])

# Define destination points
dst_pts = np.float32([
    [0, 0],
    [width, 100],
    [100, height],
    [width - 100, height - 50]
])

# Compute Perspective Transformation Matrix
matrix = cv2.getPerspectiveTransform(src_pts, dst_pts)

print("Perspective Transformation Matrix:")
print(matrix)

# Process each frame
while True:
    ret, frame = cap.read()

    if not ret:
        break

    # Apply perspective transformation
    transformed = cv2.warpPerspective(frame, matrix, (width, height))

    # Write transformed frame
    out.write(transformed)

# Release resources
cap.release()
out.release()

print("Processing Complete!")
print("Saved as:", output_name)

# Download output video
files.download(output_name)
